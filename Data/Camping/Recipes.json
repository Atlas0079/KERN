  "camp_light_campfire": {
    "verb": "LightCampfire",
    "planner_hint": "行动规则：在同地点的火堆旁，消耗自己背包中的 1 个 Wood，把火堆从 extinguished 改为 lit。耗时 5 tick。只有背包里有具体 wood 物品 id 时才能执行。",
    "grounder_hint": "target_id 必须是同地点带 campfire tag 的火堆；parameters.wood_id 必须是自己背包中带 wood tag 的具体物品 id。",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "campfire"
        },
        {
          "type": "has_tag",
          "target": "param:wood_id",
          "tag": "wood"
        },
        {
          "type": "inventory_contains",
          "owner": "self",
          "item_ref": "param:wood_id"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 5
      },
      "assign_to": "self"
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": []
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "DestroyEntity",
          "target": "param:wood_id"
        },
        {
          "effect": "RemoveStatus",
          "target": "target",
          "status_id": "extinguished"
        },
        {
          "effect": "AddStatus",
          "target": "target",
          "status_id": "lit"
        },
        {
          "effect": "EmitEvent",
          "event_type": "CampfireLit",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}点燃了火堆。"
          }
        }
      ]
    }
  },
  "camp_cook_fish": {
    "verb": "CookFood",
    "planner_hint": "行动规则：在同地点且已经 lit 的火堆旁，消耗自己背包中的 1 个 RawFish，获得 1 个 CookedFish。耗时 18 tick，消耗 4 体力。当前规则只支持烹饪 raw_fish，不支持烹饪其他食材。",
    "grounder_hint": "target_id 必须是同地点、带 campfire tag 且状态为 lit 的火堆；parameters.ingredient_id 必须是自己背包中带 raw_fish tag 的具体物品 id。",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "campfire"
        },
        {
          "type": "has_status",
          "target": "target",
          "status_id": "lit"
        },
        {
          "type": "has_tag",
          "target": "param:ingredient_id",
          "tag": "raw_fish"
        },
        {
          "type": "inventory_contains",
          "owner": "self",
          "item_ref": "param:ingredient_id"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 18
      },
      "assign_to": "self"
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": []
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "DestroyEntity",
          "target": "param:ingredient_id"
        },
        {
          "effect": "CreateEntity",
          "template": "CookedFish",
          "destination": {
            "type": "container",
            "target": "self"
          }
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_energy",
          "change": -4
        }
      ]
    }
  },
  "camp_rest": {
    "verb": "CampRest",
    "planner_hint": "行动规则：只有位于主营地 camp_main 时可以休息。默认耗时 60 tick，也可用 rest_ticks 指定至少 10 tick；完成后恢复 20 体力并降低 10 压力。休息不会产出物品。",
    "grounder_hint": "target_id 选择自己；parameters.rest_ticks 可选，必须不小于 10。执行地点必须是 camp_main。",
    "condition": {
      "type": "compare_value",
      "left": "self.location_id",
      "op": "==",
      "value": "camp_main"
    },
    "process": {
      "duration": {
        "mode": "param",
        "from_param": "param:rest_ticks",
        "default": 60,
        "min": 10
      },
      "assign_to": "self"
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": []
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_energy",
          "change": 20
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_stress",
          "change": -10
        },
        {
          "effect": "EmitEvent",
