{
  "camp_open_container": {
    "verb": "OpenContainer",
    "planner_hint": "行动规则：打开同地点可见的容器。效果是让该容器的内容变为可见；如果要从公共箱确认或选择物品，通常需要先执行这个动作。这个动作本身不消耗时间。",
    "grounder_hint": "target_id 必须选择同地点、可见、带 container tag 的实体，例如公共储物箱。不要选择箱内物品作为 target。",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "container"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "required_progress": 0
    },
    "bundle": {
      "effects": [
        {
          "effect": "ModifyProperty",
          "target": "target",
          "component": "ContainerComponent",
          "property": "slots.main.config.transparent",
          "value": true
        },
        {
          "effect": "EmitEvent",
          "event_type": "ContainerOpened",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}打开了{target.entity_name}。"
          }
        }
      ]
    }
  },
  "camp_store_item": {
    "verb": "StoreItem",
    "planner_hint": "行动规则：把自己背包中的一个物品放入同地点可见容器。用于集中公共资源或交还物资；不会自动选择物品，必须指定要存放的 item。这个动作本身不消耗时间。",
    "grounder_hint": "target_id 必须是同地点容器；parameters.item_id 必须是自己背包中的具体物品 id。",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "container"
        },
        {
          "type": "inventory_contains",
          "owner": "self",
          "item_ref": "param:item_id"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "required_progress": 0
    },
    "bundle": {
      "effects": [
        {
          "effect": "MoveEntity",
          "entity_ref": "param:item_id",
          "from_ref": "self",
          "to_ref": "target"
        }
      ]
    }
  },
  "camp_gather_wood": {
    "verb": "GatherWood",
    "planner_hint": "行动规则：只有位于林地 forest 时可以采集木材。耗时 20 tick；完成后获得 2 个 Wood 到自己背包，消耗 8 体力，增加 2 压力。当前规则中 Wood 可作为点燃火堆的燃料。",
    "grounder_hint": "target_id 选择自己；执行地点必须是 forest。不需要指定树木或工具。",
    "condition": {
      "type": "compare_value",
      "left": "self.location_id",
      "op": "==",
      "value": "forest"
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 20
      },
      "assign_to": "self",
      "task_policy": {
        "interrupt_mode": "pause_keep_progress",
        "allow_voluntary_interrupt": true,
        "allow_voluntary_cancel": true
      }
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": [
          {
            "when": {
              "type": "compare_property",
              "target": "self",
              "component": "CreatureComponent",
              "property": "current_stress",
              "op": ">=",
              "value": 70
            },
            "value": 0.65
          }
        ]
      },
      "tick_bundle": {
        "effects": []
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "CreateEntity",
          "template": "Wood",
          "destination": {
            "type": "container",
            "target": "self"
          }
        },
        {
          "effect": "CreateEntity",
          "template": "Wood",
          "destination": {
            "type": "container",
            "target": "self"
          }
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_energy",
          "change": -8
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_stress",
          "change": 2
        },
        {
          "effect": "EmitEvent",
          "event_type": "ResourceGathered",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}采集了一些木材。"
          }
        }
      ]
    }
  },
