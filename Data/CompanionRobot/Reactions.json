{
  "rules": [
    {
      "id": "child_energy_low_memory",
      "on_event": "PropertyModified",
      "selector": {
        "type": "all",
        "conditions": [
          {
            "type": "event_field_eq",
            "field": "component",
            "value": "CreatureComponent"
          },
          {
            "type": "event_field_eq",
            "field": "property",
            "value": "current_energy"
          }
        ]
      },
      "condition": {
        "type": "all",
        "conditions": [
          {
            "type": "has_tag",
            "target": "event_entity",
            "tag": "kindergarten_child"
          },
          {
            "type": "compare_property",
            "target": "event_entity",
            "component": "CreatureComponent",
            "property": "current_energy",
            "op": "<=",
            "value": 25
          },
          {
            "type": "not",
            "condition": {
              "type": "has_status",
              "target": "event_entity",
              "status_id": "energy_low_noted"
            }
          }
        ]
      },
      "bundle": {
        "effects": [
          {
            "effect": "AddStatus",
            "target": "event_entity",
            "status_id": "energy_low_noted"
          },
          {
            "effect": "AddMemoryNote",
            "target": "event_entity",
            "text": "我现在有点累。接下来应该找安静的事做、休息一下，或者问老师。",
            "importance": 0.75,
            "tags": [
              "energy",
              "self_care",
              "school_day"
            ]
          },
          {
            "effect": "EmitEvent",
            "event_type": "ChildNeedsRest",
            "payload": {
              "source_ref": "event_entity",
              "message": "{event.entity_id}的体力偏低。"
            }
          }
        ]
      }
    }
  ]
}
