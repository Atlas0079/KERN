            "story_item"
          ]
        },
        {
          "effect": "EmitEvent",
          "event_type": "MemoryItemDisplayed",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}把一个发现放到了回忆展示架。"
          }
        }
      ]
    }
  }
