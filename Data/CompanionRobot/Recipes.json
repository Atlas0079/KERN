{
  "child_tidy_toy_pile": {
    "verb": "TidyToyPile",
    "narrative_success": "{actor}开始整理{target}",
    "narrative_fail": "{actor}想整理{target}，但失败了：{reason}",
    "planner_hint": "行动规则：整理同地点可见、带 toy_pile tag 且尚未 searched 的玩具堆。耗时 6 tick；每 tick 消耗少量体力；完成后随机发现绘本、拼图或贴纸，并把事实写入记忆。",
    "grounder_hint": "target_id 必须选择同地点可见、带 toy_pile tag、状态为 messy 的玩具堆。",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "toy_pile"
        },
        {
          "type": "has_status",
          "target": "target",
          "status_id": "messy"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 6
      },
      "assign_to": "self",
      "task_policy": {
        "interrupt_mode": "pause_keep_progress",
        "allow_voluntary_interrupt": true,
        "allow_voluntary_cancel": true
      }
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": [
          {
            "effect": "ModifyProperty",
            "target": "self",
            "component": "CreatureComponent",
            "property": "current_energy",
            "change": -0.5
          }
        ]
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "RandomBundle",
          "table_id": "toy_pile_find",
          "entries": [
            {
              "id": "torn_picture_book",
              "label": "破了一页的绘本",
              "weight": 1,
              "bundle": {
                "effects": [
                  {
                    "effect": "CreateEntity",
                    "template": "TornPictureBook",
                    "destination": {
                      "type": "container",
                      "target": "self"
                    }
                  },
                  {
                    "effect": "AddMemoryNote",
                    "target": "self",
                    "text": "我整理玩具堆时发现了一本破了一页的绘本。它还没有处理。",
                    "importance": 0.85,
                    "tags": [
                      "discovery",
                      "picture_book",
                      "open_thread"
                    ]
                  },
                  {
                    "effect": "EmitEvent",
                    "event_type": "ItemFound",
                    "payload": {
                      "source_ref": "self",
                      "item_template": "TornPictureBook",
                      "message": "{self.entity_name}发现了一本破了一页的绘本。"
                    }
                  }
                ]
              }
            },
            {
              "id": "puzzle_piece",
              "label": "拼图的一角",
              "weight": 1,
              "bundle": {
                "effects": [
                  {
                    "effect": "CreateEntity",
                    "template": "PuzzlePiece",
                    "destination": {
                      "type": "container",
                      "target": "self"
                    }
                  },
                  {
                    "effect": "AddMemoryNote",
                    "target": "self",
                    "text": "我整理玩具堆时发现了一块拼图的一角。另一半还没出现。",
                    "importance": 0.8,
                    "tags": [
                      "discovery",
                      "puzzle",
                      "open_thread"
                    ]
                  },
                  {
                    "effect": "EmitEvent",
                    "event_type": "ItemFound",
                    "payload": {
                      "source_ref": "self",
                      "item_template": "PuzzlePiece",
                      "message": "{self.entity_name}发现了一块拼图的一角。"
                    }
                  }
                ]
              }
            },
            {
              "id": "sticker_patch",
              "label": "贴纸补丁",
              "weight": 2,
              "bundle": {
                "effects": [
                  {
                    "effect": "CreateEntity",
                    "template": "StickerPatch",
                    "destination": {
                      "type": "container",
                      "target": "self"
                    }
                  },
                  {
                    "effect": "AddMemoryNote",
                    "target": "self",
                    "text": "我整理玩具堆时找到了一张贴纸补丁。它可以用于修补。",
                    "importance": 0.65,
                    "tags": [
                      "discovery",
                      "craft_material"
                    ]
                  },
                  {
                    "effect": "EmitEvent",
                    "event_type": "MaterialFound",
                    "payload": {
                      "source_ref": "self",
                      "item_template": "StickerPatch",
                      "message": "{self.entity_name}找到了一张贴纸补丁。"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "effect": "RemoveStatus",
          "target": "target",
          "status_id": "messy"
        },
        {
          "effect": "AddStatus",
          "target": "target",
          "status_id": "searched"
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_energy",
          "change": -3
        },
        {
          "effect": "EmitEvent",
          "event_type": "ToyPileTidied",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}整理完了一堆玩具。"
          }
        }
      ]
    }
  },
  "child_rest_quietly": {
    "verb": "RestQuietly",
    "narrative_success": "{actor}开始在{target}休息",
    "narrative_fail": "{actor}想休息，但失败了：{reason}",
    "planner_hint": "行动规则：位于 rest_corner 时可以休息。耗时 5 tick；完成后恢复体力并降低压力。",
    "grounder_hint": "target_id 选择自己或同地点可见的 rest_spot。",
    "condition": {
      "type": "compare_value",
      "left": "self.location_id",
      "op": "==",
      "value": "rest_corner"
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 5
      },
      "assign_to": "self"
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": []
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_energy",
          "change": 25
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_stress",
          "change": -8
        },
        {
          "effect": "RemoveStatus",
          "target": "self",
          "status_id": "energy_low_noted"
        },
        {
          "effect": "AddMemoryNote",
          "target": "self",
          "text": "我在休息角安静待了一会儿，体力恢复了一些。",
          "importance": 0.6,
          "tags": [
            "rest",
            "self_care"
          ]
        },
        {
          "effect": "EmitEvent",
          "event_type": "ChildRested",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}在休息角安静休息。"
          }
        }
      ]
    }
  },
  "child_repair_lamp": {
    "verb": "RepairObject",
    "narrative_success": "{actor}开始修补{target}",
    "narrative_fail": "{actor}想修补{target}，但失败了：{reason}",
    "planner_hint": "行动规则：修补同地点可见的故事灯。需要 parameters.part_id 指向背包中的 repair_material。耗时 5 tick；完成后灯变为 repaired_lamp。",
    "grounder_hint": "target_id 必须是同地点可见、带 lamp tag 的灯；parameters.part_id 必须是自己背包中的 repair_material 物品 id。",
    "selector": {
      "type": "has_tag",
      "target": "target",
      "tag": "lamp"
    },
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "lamp"
        },
        {
          "type": "has_status",
          "target": "target",
          "status_id": "broken"
        },
        {
          "type": "has_tag",
          "target": "param:part_id",
          "tag": "repair_material"
        },
        {
          "type": "inventory_contains",
          "owner": "self",
          "item_ref": "param:part_id"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 5
      },
      "assign_to": "self"
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": [
          {
            "effect": "ModifyProperty",
            "target": "self",
            "component": "CreatureComponent",
            "property": "current_energy",
            "change": -0.5
          }
        ]
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "DestroyEntity",
          "target": "param:part_id"
        },
        {
          "effect": "RemoveStatus",
          "target": "target",
          "status_id": "broken"
        },
        {
          "effect": "RemoveStatus",
          "target": "target",
          "status_id": "blocks_quiet_library"
        },
        {
          "effect": "AddStatus",
          "target": "target",
          "status_id": "repaired_lamp"
        },
        {
          "effect": "AddMemoryNote",
          "target": "self",
          "text": "我用贴纸补丁修好了故事灯。",
          "importance": 0.8,
          "tags": [
            "repair",
            "lamp"
          ]
        },
        {
          "effect": "EmitEvent",
          "event_type": "StoryLampRepaired",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}修好了故事灯。"
          }
        }
      ]
    }
  },
