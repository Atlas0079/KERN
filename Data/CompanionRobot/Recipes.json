  "robot_explore_dark_storage": {
    "verb": "ExplorePlace",
    "narrative_success": "{actor}开始探索储藏间",
    "narrative_fail": "{actor}想探索储藏间，但失败了：{reason}",
    "planner_hint": "行动规则：只有位于 dark_storage 时可以探索储藏间。耗时 8 tick；可能发现滴滴响的装置或零件。若感知到光线不足且还没有修好灯，豆豆应倾向先准备照明或向小朋友请教。",
    "grounder_hint": "target_id 选择自己；执行地点必须是 dark_storage。不需要指定具体柜子。",
    "condition": {
      "type": "compare_value",
      "left": "self.location_id",
      "op": "==",
      "value": "dark_storage"
    },
    "process": {
      "duration": {
        "mode": "fixed",
        "value": 8
      },
      "assign_to": "self"
    },
    "progression": {
      "progressor": "Linear",
      "params": {
        "base_progress_per_tick": 1.0,
        "add_terms": [],
        "mul_terms": []
      },
      "tick_bundle": {
        "effects": [
          {
            "effect": "ModifyProperty",
            "target": "self",
            "component": "CreatureComponent",
            "property": "current_energy",
            "change": -0.7
          }
        ]
      }
    },
    "bundle": {
      "effects": [
        {
          "effect": "RandomBundle",
          "table_id": "dark_storage_find",
          "entries": [
            {
              "id": "beeping_device",
              "label": "滴滴响的装置",
              "weight": 1,
              "bundle": {
                "effects": [
                  {
                    "effect": "CreateEntity",
                    "template": "BeepingDevice",
                    "destination": {
                      "type": "container",
                      "target": "self"
                    }
                  },
                  {
                    "effect": "AddMemoryNote",
                    "target": "self",
                    "text": "我在储藏间发现了一个滴滴响的装置。我还不知道它是做什么的，下次想和小朋友一起想办法。",
                    "importance": 0.9,
                    "tags": [
                      "discovery",
                      "help_request",
                      "beeping_device"
                    ]
                  },
                  {
                    "effect": "EmitEvent",
                    "event_type": "HelpRequestCreated",
                    "payload": {
                      "source_ref": "self",
                    "message": "{self.entity_name}发现滴滴响的装置，需要小朋友建议。"
                    }
                  }
                ]
              }
            },
            {
              "id": "tiny_plant",
              "label": "快枯萎的植物",
              "weight": 1,
              "bundle": {
                "effects": [
                  {
                    "effect": "CreateEntity",
                    "template": "TinyPlant",
                    "destination": {
                      "type": "container",
                      "target": "self"
                    }
                  },
                  {
                    "effect": "AddMemoryNote",
                    "target": "self",
                    "text": "我在储藏间发现了一株快枯萎的植物。我不知道该不该留下照顾它，下次想问问小朋友。",
                    "importance": 0.85,
                    "tags": [
                      "discovery",
                      "help_request",
                      "plant"
                    ]
                  }
                ]
              }
            },
            {
              "id": "parts",
              "label": "一个零件",
              "weight": 2,
              "bundle": {
                "effects": [
                  {
                    "effect": "CreateEntity",
                    "template": "ScrapPart",
                    "destination": {
                      "type": "container",
                      "target": "self"
                    }
                  },
                  {
                    "effect": "AddMemoryNote",
                    "target": "self",
                    "text": "我在储藏间找到了一个零件。准备好再探索，好像真的有帮助。",
                    "importance": 0.75,
                    "tags": [
                      "discovery",
                      "parts",
                      "lesson"
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "effect": "ModifyProperty",
          "target": "self",
          "component": "CreatureComponent",
          "property": "current_energy",
          "change": -5
        },
        {
          "effect": "EmitEvent",
          "event_type": "DarkStorageExplored",
          "payload": {
            "source_ref": "self",
            "message": "{self.entity_name}探索了储藏间。"
          }
        }
      ]
