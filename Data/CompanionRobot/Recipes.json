  },
  "robot_store_memory_item": {
    "verb": "StoreMemoryItem",
    "narrative_success": "{actor}把发现放到{target}",
    "narrative_fail": "{actor}想把发现放到{target}，但失败了：{reason}",
    "planner_hint": "行动规则：把自己背包中的 story_item 放到同地点的收藏架。用于保留有意义的发现，并为之后对话提供回顾素材。",
    "grounder_hint": "target_id 必须是同地点可见的 memory_shelf；parameters.item_id 必须是自己背包中的 story_item。",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "memory_shelf"
        },
        {
          "type": "has_tag",
          "target": "param:item_id",
          "tag": "story_item"
        },
        {
          "type": "inventory_contains",
          "owner": "self",
          "item_ref": "param:item_id"
        },
        {
          "type": "same_location",
          "left": "self",
          "right": "target"
        }
      ]
    },
    "process": {
      "required_progress": 0
    },
    "bundle": {
      "effects": [
        {
          "effect": "MoveEntity",
          "entity_ref": "param:item_id",
          "from_ref": "self",
          "to_ref": "target"
        },
        {
          "effect": "AddMemoryNote",
          "target": "self",
          "text": "我把一个有意义的发现放到了小小收藏架。以后和小朋友聊天时，可以回顾它。",
          "importance": 0.75,
          "tags": [
            "memory_shelf",
            "story_item"
          ]
        }
      ]
    }
  }
}
