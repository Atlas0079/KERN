{
  "social_phone_browse_feed": {
    "verb": "BrowseSocialFeed",
    "planner_hint": "Browse the recommendation feed on a phone you carry.",
    "grounder_hint": "target_id must be the carried phone from your inventory. parameters.limit is optional.",
    "condition": {
      "type": "all",
      "conditions": [
        {
          "type": "has_tag",
          "target": "target",
          "tag": "phone"
        },
        {
          "type": "has_component",
          "target": "target",
          "component": "ScreenComponent"
        },
        {
          "type": "inventory_contains",
          "owner": "self",
          "item_ref": "target"
        }
      ]
    },
    "process": {
      "required_progress": 0
    },
    "bundle": {
      "effects": [
        {
          "effect": "ObserveSocialFeed",
          "target": "target",
          "limit": "param:limit"
        }
      ]
    }
  },
