{
  "rumor_browse_feed": {
    "verb": "BrowseSocialFeed",
    "planner_hint": "Browse the recommendation feed on your carried phone when you have a social platform activity opportunity.",
    "grounder_hint": "target_id must be the carried phone from inventory. parameters.limit is optional; use 8 when refreshing a general feed.",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_tag", "target": "target", "tag": "phone"},
        {"type": "has_component", "target": "target", "component": "ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "ObserveSocialFeed", "target": "target", "limit": "param:limit:8"}
      ]
    }
  },
  "rumor_open_post": {
    "verb": "OpenSocialPost",
    "planner_hint": "Open a visible post from the carried phone's fresh feed context.",
    "grounder_hint": "target_id must be the carried phone. parameters.slot selects the feed item; default is 0.",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_tag", "target": "target", "tag": "phone"},
        {"type": "has_component", "target": "target", "component": "ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "ObserveSocialPost", "target": "target", "slot": "param:slot"},
        {"effect": "AddStatus", "target": "self", "status_id": "social_action_cooldown", "duration_ticks": 2}
      ]
    }
  },
  "rumor_comment_post": {
    "verb": "CommentSocialPost",
    "planner_hint": "Comment on a currently visible or open post if your reaction is grounded in the context.",
    "grounder_hint": "target_id must be the carried phone. parameters.text is required; parameters.slot is optional.",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_tag", "target": "target", "tag": "phone"},
        {"type": "has_component", "target": "target", "component": "ScreenComponent"},
