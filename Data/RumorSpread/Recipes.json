  "rumor_create_post": {
    "verb": "CreateSocialPost",
    "planner_hint": "Create an original post only when recent memories, offline context, or platform content gives you a reason to express a grounded reaction.",
    "grounder_hint": "target_id must be the carried phone. parameters.text is required; parameters.tags is optional.",
