      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "InteractSocialPost", "target": "target", "slot": "param:slot", "action": "comment", "text": "param:text"},
        {"effect": "AddStatus", "target": "self", "status_id": "social_action_cooldown", "duration_ticks": 2}
      ]
    }
  },
