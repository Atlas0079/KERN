{
  "packages": [
    { "path": "Packages/SU7Crisis", "world": true }
  ],
  "env": {
    "USE_LLM": "0",
    "LOG_LEVEL": "warn",
    "LOG_CATEGORIES": "system,executor,interaction,checkpoint,llm",
    "MAX_TICKS": "12",
    "CHECKPOINT_DIR": "checkpoints/su7_crisis_100agent",
    "CHECKPOINT_EVERY_TICK": "1",
    "CHECKPOINT_SNAPSHOT_INTERVAL_TICKS": "5",
    "WORKFLOW_CONTRACT_ON_ERROR": "degrade_to_noop",
    "WORKFLOW_VIEW_PROFILE": "social_platform",
    "EXTERNAL_RUNTIMES_JSON": "{\"social\":{\"type\":\"sqlite_social_platform\",\"db_path\":\"checkpoints/su7_crisis_100agent/social.sqlite3\",\"reset_db\":true,\"seed_json\":\"Packages/SU7Crisis/Data/social_seed.json\"}}"
  }
}
