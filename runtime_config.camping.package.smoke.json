{
  "packages": [
    { "path": "Packages/Camping", "world": true }
  ],
  "default_workflow_provider": {"kind": "simple"},
  "env": {
    "LOG_LEVEL": "warn",
    "LOG_CATEGORIES": "system,executor,task,interaction,checkpoint",
    "DIALOGUE_LOG_FULL": "0",
    "MAX_TICKS": "60",
    "CHECKPOINT_DIR": "checkpoints/camping_smoke",
    "CHECKPOINT_EVERY_TICK": "1",
    "CHECKPOINT_INCLUDE_LOGS": "1",
    "CHECKPOINT_SNAPSHOT_INTERVAL_TICKS": "60"
  }
}
