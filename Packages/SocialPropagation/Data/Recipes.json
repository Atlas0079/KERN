{
  "social_browse_feed": {
    "verb": "BrowseSocialFeed",
    "planner_hint": "查看自己手机上的社交平台推荐页。页面最多显示 8 条内容卡片，只显示标题、来源和互动数量，并记录这些内容已实际呈现给你。浏览后需要先点开帖子详情，才能点赞、评论或转发。",
    "grounder_hint": "target_id 必须选择自己背包中带 social_media_terminal tag 且包含 social_propagation:ScreenComponent 的手机。不需要其他参数。",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_tag", "target": "target", "tag": "social_media_terminal"},
        {"type": "has_component", "target": "target", "component": "social_propagation:ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "social_propagation:RefreshFeed", "terminal": "target", "limit": 8}
      ],
      "record": {"mode": "auto", "target": "self"}
    }
  },
  "social_open_post_detail": {
    "verb": "OpenSocialPost",
    "planner_hint": "点开当前推荐页中实际可见的一条帖子，进入帖子详情页查看全文和近期评论。",
    "grounder_hint": "target_id 选择自己的社交平台手机；parameters.post_id 必须来自该手机当前 feed_items。",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_component", "target": "target", "component": "social_propagation:ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "social_propagation:OpenPostDetail", "terminal": "target", "post_id": "param:post_id"}
      ],
      "record": {"mode": "auto", "target": "self"}
    }
  },
  "social_back_to_feed": {
    "verb": "BackToSocialFeed",
    "planner_hint": "从当前帖子详情页返回刚才的社交平台推荐页。",
    "grounder_hint": "target_id 选择自己的社交平台手机；不需要其他参数。",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_component", "target": "target", "component": "social_propagation:ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "social_propagation:BackToFeed", "terminal": "target"}
      ],
      "record": {"mode": "auto", "target": "self"}
    }
  },
  "social_repost_visible_post": {
    "verb": "RepostSocialPost",
    "planner_hint": "转发当前帖子详情页中的帖子。其他关注你的用户之后可能会在推荐流或关注流里看到你转发的帖子；可选 parameters.text 作为转发语。",
    "grounder_hint": "target_id 选择自己的社交平台手机；parameters.post_id 必须是当前 current_post 的 post_id；parameters.text 可选。",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_component", "target": "target", "component": "social_propagation:ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "social_propagation:RepostVisiblePost", "terminal": "target", "post_id": "param:post_id", "text": "param:text"}
      ],
      "record": {"mode": "auto", "target": "self"}
    }
  },
  "social_like_visible_post": {
    "verb": "LikeSocialPost",
    "planner_hint": "点赞当前帖子详情页中的帖子。同一账号对同一原帖只能点赞一次。",
    "grounder_hint": "target_id 选择自己的社交平台手机；parameters.post_id 必须是当前 current_post 的 post_id。",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_component", "target": "target", "component": "social_propagation:ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "social_propagation:LikeVisiblePost", "terminal": "target", "post_id": "param:post_id"}
      ],
      "record": {"mode": "auto", "target": "self"}
    }
  },
  "social_comment_visible_post": {
    "verb": "CommentOnSocialPost",
    "planner_hint": "在当前帖子详情页中的原帖下发表评论。评论直接属于原帖，不是新帖子，也不能回复其他评论。",
    "grounder_hint": "target_id 选择自己的社交平台手机；parameters.post_id 必须是当前 current_post 的 post_id；parameters.text 必须是非空评论正文。",
    "condition": {
      "type": "all",
      "conditions": [
        {"type": "has_component", "target": "target", "component": "social_propagation:ScreenComponent"},
        {"type": "inventory_contains", "owner": "self", "item_ref": "target"}
      ]
    },
    "process": {"required_progress": 0},
    "bundle": {
      "effects": [
        {"effect": "social_propagation:CommentOnVisiblePost", "terminal": "target", "post_id": "param:post_id", "text": "param:text"}
      ],
      "record": {"mode": "auto", "target": "self"}
    }
  }
}
