      "gig_flexible": {"外卖骑手": 1.0, "网约车司机": 1.0, "自由接单设计师": 1.0, "兼职家教": 1.0, "平台接单维修工": 1.0},
      "office_admin": {"行政助理": 1.0, "人事专员": 1.0, "运营专员": 1.0, "财务文员": 1.0, "项目协调员": 1.0},
      "technical": {"后端开发工程师": 1.0, "数据分析师": 1.0, "测试工程师": 1.0, "机械维修技术员": 1.0, "网络运维": 1.0},
      "creative_media": {"短视频剪辑师": 1.0, "平面设计师": 1.0, "摄影助理": 1.0, "自媒体编辑": 1.0, "直播运营": 1.0},
      "care_education": {"幼儿园老师": 1.0, "社区社工": 1.0, "养老护理员": 1.0, "培训机构老师": 1.0, "托育中心助教": 1.0},
      "trades_manual": {"水电维修工": 1.0, "木工": 1.0, "厨师": 1.0, "仓库叉车工": 1.0, "装修工": 1.0},
      "small_business": {"小餐馆老板": 1.0, "社区杂货铺店主": 1.0, "网店店主": 1.0, "花店经营者": 1.0, "修车铺合伙人": 1.0},
      "between_jobs": {"刚离职正在找工作": 1.0, "合同到期正在求职": 1.0, "照顾家人后准备重返职场": 1.0},
      "retired": {"退休工人": 1.0, "退休教师": 1.0, "退休护士": 1.0, "半退休个体经营者": 1.0}
    }
  },
  "interests": {
    "practical": {"count_weights": {"2": 0.55, "3": 0.45}, "item_weights": {"home_cooking": 1.0, "walking_hiking": 1.0, "casual_fitness": 1.0, "gaming": 1.0, "crafts": 1.0, "community_events": 1.0, "reading": 1.0, "photography": 1.0, "gardening": 1.0, "parent_child": 1.0}},
    "aspirational": {"count_weights": {"1": 0.55, "2": 0.45}, "item_weights": {"travel_watching": 1.0, "premium_tech_watching": 1.0, "home_design_watching": 1.0, "career_learning": 1.0, "financial_learning": 1.0, "culture_art": 1.0}},
    "high_cost": {"count_weights": {"1": 1.0}, "inclusion_probability_by_economic_pressure": {"severe": 0.0, "tight": 0.0, "manageable": 0.0, "comfortable": 0.12, "affluent": 0.38}, "item_weights": {"frequent_travel": 1.0, "premium_technology": 1.0, "collecting": 1.0}},
    "science_topics": {"count_weights": {"0": 1.0}, "item_weights": {"climate_risk": 1.0, "public_health": 1.0, "technology_society": 1.0, "environment": 1.0}}
  }
