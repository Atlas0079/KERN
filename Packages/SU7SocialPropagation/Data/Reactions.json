{
  "rules": [
    {
      "id": "su7_world_tick_social_session_round",
      "on_event": "WorldTickAdvanced",
      "bundle": {
        "effects": [
          {
            "effect": "social_propagation:SocialSessionRound",
            "max_agents_per_round": 100,
            "decision_mode": "serial",
            "max_decision_workers": 1,
            "policy": {
              "selection": {"kind": "social_behavior_rate", "base_rate_multiplier": 1.0},
              "session": {"initial_feed_limit": 8, "max_feed_pages": 3, "max_open_posts": 2, "max_terminal_actions": 1},
              "permissions": {"allow_create_post": true, "like_requires_open_post": false, "comment_requires_open_post": true, "repost_requires_open_post": true}
            }
          }
        ]
      }
    },
    {
      "id": "su7_world_tick_environment_condition",
      "on_event": "WorldTickAdvanced",
      "bundle": {
        "effects": [
          {
            "effect": "EnvironmentConditionTick"
          }
        ]
      }
    },
    {
      "id": "su7_advance_tick_status",
      "on_event": "AdvanceTick",
      "condition": {
        "type": "has_component",
        "target": "event_entity",
        "component": "StatusComponent"
      },
      "bundle": {
        "effects": [
          {
            "effect": "StatusTick"
          }
        ]
      }
    }
  ]
}
